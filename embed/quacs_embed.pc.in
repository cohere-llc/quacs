prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: quacs_embed
Description: Runs QUACS parameterizations inside a host application
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lquacs_embed -Wl,-rpath,${libdir}
